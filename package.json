{
  "name": "collinson-issue-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx src/sdd-framework/cli/test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "mock-github": "tsx src/mock-github/main.ts",
    "prototype-issues-reader": "tsx --env-file-if-exists=.env src/issue-tracker/main.ts",
    "issues-tracker": "tsx --env-file-if-exists=.env src/issue-tracker/proactiveMain.ts",
    "enrich": "tsx --env-file-if-exists=.env src/sdd-framework/cli/enrich.ts",
    "enrich:accs": "tsx --env-file-if-exists=.env src/sdd-framework/cli/enrich.ts --accs",
    "apply": "tsx --env-file-if-exists=.env src/sdd-framework/cli/apply.ts",
    "commit": "tsx --env-file-if-exists=.env src/sdd-framework/cli/commit.ts",
    "verify": "tsx --env-file-if-exists=.env src/sdd-framework/cli/verify.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.96",
    "@anthropic-ai/sdk": "^0.72.0",
    "jsonrepair": "^3.13.3",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.3",
    "@commitlint/config-conventional": "^19.0.3",
    "@eslint/js": "^9.39.0",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^16.5.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.0.9"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~5.9.3"
    }
  }
}
