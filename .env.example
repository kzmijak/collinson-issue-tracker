# The repository the reader polls, as owner/repo
GITHUB_REPO=owner/repo
# Seconds between polls
POLL_INTERVAL_SECONDS=5
# real | mock — mock serves a fixed dataset so the acceptance check needs no network or token
GITHUB_API_MODE=real
# Optional: raises the API rate limit; required only for a private repository
GITHUB_TOKEN=

# Used by the acceptance check only: forces N consecutive mock failures to exercise backoff
GITHUB_MOCK_FAIL_COUNT=

# mock is the only accepted value in this spec — pnpm issues-tracker refuses to start otherwise
GITHUB_MODE=mock
# Port the mock GitHub service binds its HTTP API and terminal to
MOCK_GITHUB_PORT=4123
# Optional: overrides MOCK_GITHUB_PORT entirely as the base URL pnpm issues-tracker polls
MOCK_GITHUB_URL=
# Milliseconds between pnpm issues-tracker poll cycles
ISSUES_TRACKER_POLL_INTERVAL_MS=2000
# Optional: fixes the mock GitHub terminal's per-screen line cap, overriding the TTY-rows/200 default
MOCK_GITHUB_BUFFER_CAP=

# Long-lived token from `claude setup-token`, used by pnpm enrich / verify / commit
CLAUDE_CODE_OAUTH_TOKEN=

# Root directory for classifier output (classifications.jsonl); overridable so a test run can point elsewhere
GENERATED_DIR=.generated
# Model, effort and thinking used by `pnpm classify` — copied verbatim into each classification's meta.llmConfig
CLASSIFIER_MODEL=claude-haiku-4-5
CLASSIFIER_EFFORT=low
CLASSIFIER_THINKING=false
